{
  "_source": "RCPA / BSH / WHO / Sri Lankan laboratory standards 2023",
  "_note": "Adult reference ranges unless specified. Cholesterol in mmol/L; haemoglobin in g/dL.",
  "haematology": {
    "haemoglobin": {
      "adult_male":   { "low": 13.0, "high": 17.5, "unit": "g/dL" },
      "adult_female": { "low": 11.5, "high": 16.0, "unit": "g/dL" },
      "pregnant":     { "low": 10.5, "high": 14.0, "unit": "g/dL" },
      "elderly":      { "low": 12.0, "high": 17.5, "unit": "g/dL" }
    },
    "wbc": { "low": 4.0, "high": 11.0, "unit": "x10⁹/L" },
    "neutrophils": { "low": 1.8, "high": 7.5, "unit": "x10⁹/L" },
    "lymphocytes": { "low": 1.0, "high": 4.5, "unit": "x10⁹/L" },
    "monocytes":   { "low": 0.2, "high": 1.0, "unit": "x10⁹/L" },
    "eosinophils": { "low": 0.0, "high": 0.5, "unit": "x10⁹/L" },
    "basophils":   { "low": 0.0, "high": 0.1, "unit": "x10⁹/L" },
    "platelets":   { "low": 150, "high": 400, "unit": "x10⁹/L" },
    "mcv":         { "low": 80, "high": 100, "unit": "fL" },
    "mch":         { "low": 27, "high": 33, "unit": "pg" },
    "mchc":        { "low": 315, "high": 360, "unit": "g/L" },
    "reticulocytes": { "low": 0.5, "high": 2.5, "unit": "%" }
  },
  "iron_studies": {
    "serum_iron":    { "adult_male": { "low": 10.7, "high": 28.6, "unit": "µmol/L" },
                       "adult_female": { "low": 7.2, "high": 26.7, "unit": "µmol/L" } },
    "tibc":          { "low": 45, "high": 80, "unit": "µmol/L" },
    "transferrin_saturation": { "low": 20, "high": 50, "unit": "%" },
    "ferritin":      { "adult_male": { "low": 30, "high": 300, "unit": "µg/L" },
                       "adult_female": { "low": 13, "high": 150, "unit": "µg/L" } }
  },
  "biochemistry": {
    "sodium":       { "low": 136, "high": 145, "unit": "mmol/L" },
    "potassium":    { "low": 3.5, "high": 5.0, "unit": "mmol/L" },
    "chloride":     { "low": 98, "high": 107, "unit": "mmol/L" },
    "bicarbonate":  { "low": 22, "high": 29, "unit": "mmol/L" },
    "urea":         { "low": 2.5, "high": 7.8, "unit": "mmol/L" },
    "creatinine":   { "adult_male": { "low": 62, "high": 115, "unit": "µmol/L" },
                      "adult_female": { "low": 44, "high": 97, "unit": "µmol/L" } },
    "egfr":         { "low": 60, "high": 999, "unit": "mL/min/1.73m²", "note": "CKD G3a if 45-59; G3b 30-44; G4 15-29; G5 <15" },
    "glucose_fasting": { "low": 3.9, "high": 5.5, "unit": "mmol/L" },
    "glucose_random":  { "low": 3.9, "high": 7.8, "unit": "mmol/L" },
    "hba1c":           { "low": 20, "high": 42, "unit": "mmol/mol", "note": "Prediabetes 42-47; Diabetes ≥48" },
    "calcium_total":   { "low": 2.15, "high": 2.60, "unit": "mmol/L" },
    "calcium_corrected": { "low": 2.15, "high": 2.60, "unit": "mmol/L" },
    "phosphate":       { "low": 0.8, "high": 1.5, "unit": "mmol/L" },
    "magnesium":       { "low": 0.7, "high": 1.0, "unit": "mmol/L" },
    "uric_acid":       { "adult_male": { "low": 0.21, "high": 0.45, "unit": "mmol/L" },
                         "adult_female": { "low": 0.15, "high": 0.36, "unit": "mmol/L" } }
  },
  "lipids": {
    "total_cholesterol": { "low": 0, "high": 5.0, "unit": "mmol/L", "note": "Desirable <5.0; high risk target varies by CVD risk" },
    "ldl_cholesterol":   { "low": 0, "high": 3.0, "unit": "mmol/L", "note": "Target varies: LOW risk <3.0; MODERATE <2.6; HIGH <1.8; VERY HIGH <1.4" },
    "hdl_cholesterol":   { "adult_male": { "low": 1.0, "high": 3.5, "unit": "mmol/L" },
                           "adult_female": { "low": 1.2, "high": 3.5, "unit": "mmol/L" } },
    "triglycerides":     { "low": 0, "high": 1.7, "unit": "mmol/L", "note": "Normal <1.7; high 1.7-5.6; very high >5.6; pancreatitis risk >11.3" },
    "non_hdl_cholesterol": { "low": 0, "high": 3.4, "unit": "mmol/L" },
    "tc_hdl_ratio":      { "low": 0, "high": 5.0, "unit": "ratio" }
  },
  "liver_function": {
    "alt":        { "adult_male": { "low": 7, "high": 56, "unit": "U/L" },
                   "adult_female": { "low": 7, "high": 45, "unit": "U/L" } },
    "ast":        { "low": 10, "high": 40, "unit": "U/L" },
    "ggt":        { "adult_male": { "low": 8, "high": 61, "unit": "U/L" },
                   "adult_female": { "low": 5, "high": 36, "unit": "U/L" } },
    "alp":        { "low": 44, "high": 147, "unit": "U/L" },
    "bilirubin_total": { "low": 3, "high": 21, "unit": "µmol/L" },
    "bilirubin_direct": { "low": 0, "high": 5, "unit": "µmol/L" },
    "albumin":    { "low": 35, "high": 50, "unit": "g/L" },
    "total_protein": { "low": 60, "high": 80, "unit": "g/L" }
  },
  "renal": {
    "urine_protein":      { "low": 0, "high": 0.15, "unit": "g/day", "note": "Microalbuminuria 30-300 mg/day; proteinuria >300 mg/day" },
    "urine_acr":          { "low": 0, "high": 3.0, "unit": "mg/mmol", "note": "Microalbuminuria 3-30; Macroalbuminuria >30" },
    "urine_creatinine":   { "low": 5.3, "high": 15.9, "unit": "mmol/L" }
  },
  "thyroid": {
    "tsh":     { "low": 0.4, "high": 4.0, "unit": "mIU/L", "note": "Target on levothyroxine: 0.5-2.5" },
    "free_t4": { "low": 9.0, "high": 25.0, "unit": "pmol/L" },
    "free_t3": { "low": 3.5, "high": 6.5, "unit": "pmol/L" }
  },
  "vitamins_minerals": {
    "vitamin_b12": { "low": 180, "high": 914, "unit": "pmol/L", "note": "Deficiency <150; borderline 150-220" },
    "folate_serum": { "low": 7.0, "high": 45.0, "unit": "nmol/L" },
    "vitamin_d":    { "low": 50, "high": 250, "unit": "nmol/L", "note": "Deficiency <25; insufficiency 25-50; optimal 50-125" },
    "ferritin_replete": { "low": 50, "high": 300, "unit": "µg/L", "note": "Post-IDA treatment target >50" }
  },
  "inflammation": {
    "crp":     { "low": 0, "high": 5.0, "unit": "mg/L", "note": "hs-CRP >2.0 mg/L — CVD reclassification factor (ESC 2021)" },
    "esr":     { "low": 0, "high": 20, "unit": "mm/hr", "note": "Age-adjusted: male=(age/2); female=(age+10)/2" }
  },
  "cardiac_markers": {
    "troponin_i":  { "low": 0, "high": 0.04, "unit": "ng/mL" },
    "troponin_t":  { "low": 0, "high": 0.014, "unit": "ng/mL" },
    "bnp":         { "low": 0, "high": 100, "unit": "pg/mL" },
    "nt_probnp":   { "low": 0, "high": 125, "unit": "pg/mL" }
  },
  "coagulation": {
    "pt":    { "low": 9.0, "high": 12.5, "unit": "seconds" },
    "inr":   { "low": 0.9, "high": 1.2, "unit": "ratio", "note": "Therapeutic range warfarin: 2.0-3.0 (AF/DVT); 2.5-3.5 (metallic valve)" },
    "aptt":  { "low": 25, "high": 38, "unit": "seconds" },
    "d_dimer": { "low": 0, "high": 0.5, "unit": "µg/mL FEU", "note": "Age-adjusted: >50 yrs use age × 0.01 µg/mL threshold" }
  },
  "tumour_markers": {
    "psa":       { "low": 0, "high": 4.0, "unit": "ng/mL", "note": "Age-adjusted: <50=2.5; 50-59=3.5; 60-69=4.5; >70=6.5" },
    "cea":       { "low": 0, "high": 3.4, "unit": "ng/mL", "note": "Smokers up to 5.0" },
    "ca125":     { "low": 0, "high": 35, "unit": "U/mL" },
    "ca199":     { "low": 0, "high": 37, "unit": "U/mL" },
    "afp":       { "low": 0, "high": 7.0, "unit": "ng/mL" },
    "beta_hcg":  { "low": 0, "high": 5.0, "unit": "mIU/mL", "note": "Male and non-pregnant female" }
  },
  "endocrine": {
    "cortisol_am":  { "low": 171, "high": 536, "unit": "nmol/L" },
    "insulin_fasting": { "low": 18, "high": 173, "unit": "pmol/L" },
    "homa_ir":      { "low": 0, "high": 2.0, "unit": "index", "note": ">2.5 insulin resistance; >5 significant" }
  }
}
